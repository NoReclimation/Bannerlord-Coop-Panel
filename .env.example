# Copy to repo root as .env (never commit secrets)

# --- API ---
API_HOST=0.0.0.0
API_PORT=3000
DATABASE_URL=postgres://bannerlord:bannerlord@127.0.0.1:5432/bannerlord_panel
CORS_ORIGIN=http://localhost:5173

# JWT (change in production)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Seeded admin (created on first migrate/boot if missing)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# Default host seed (Management Agent for this machine)
DEFAULT_HOST_ID=00000000-0000-4000-8000-000000000001
DEFAULT_HOST_NAME=local
DEFAULT_HOST_DATA_ROOT=/var/lib/bannerlord-panel
# Shared with the agent; stored hashed in PostgreSQL
DEFAULT_AGENT_TOKEN=dev-agent-token-change-me

# --- Agent ---
AGENT_HOST=0.0.0.0
AGENT_PORT=3001
API_URL=http://127.0.0.1:3000
HOST_ID=00000000-0000-4000-8000-000000000001
AGENT_TOKEN=dev-agent-token-change-me
AGENT_DATA_ROOT=/var/lib/bannerlord-panel
AGENT_NAME=local
HEARTBEAT_INTERVAL_MS=10000
DOCKER_SOCKET=/var/run/docker.sock
RUNTIME_IMAGE=bannerlord-panel/runtime:latest
